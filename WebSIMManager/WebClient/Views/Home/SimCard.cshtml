@using Commons.Enums
@model Models.Requests.GetSIMRequest
@{
    ViewData["Title"] = "Trang chủ";
}
@functions {
    // Tập trung lựa chọn logo, tránh lỗi NullReferenceException khi Network null.
    public string SimNetworkImage(string network)
    {
        var name = (network ?? string.Empty).ToLowerInvariant();
        if (name.Contains("viettel")) return "~/assets/img/network/sim-vietel.png";
        if (name.Contains("vietnamobile")) return "~/assets/img/network/sim-vina.png"; // Giữ ảnh dự phòng từ trang gốc.
        if (name.Contains("vina")) return "~/assets/img/network/sim-vina.png";
        if (name.Contains("mobi")) return "~/assets/img/network/sim-mobi.png";
        if (name.Contains("gmobile")) return "~/assets/img/network/sim-gmobile.png";
        if (name.Contains("itel")) return "~/assets/img/network/sim-itel.png";
        if (name.Contains("reddi")) return "~/assets/img/network/sim-reddi.png";
        return "~/assets/img/network/sim-vina.png";
    }
}
<style>
    /* Giữ kích thước thẻ gốc; nút bấm phủ toàn bộ bề mặt thẻ SIM. */
    .simcard-grid .simcard-col {
        display: flex;
        margin-bottom: 12px;
        min-width: 0;
    }

    .simcard-grid .sim-item.sim-hot {
        box-sizing: border-box;
        position: relative;
        width: 100%;
        min-width: 0;
        padding: 0 !important; /* Bỏ padding cũ gây lệch nội dung và thu nhỏ vùng hover. */
        margin: 0;
        border-radius: 6px;
        overflow: hidden;
    }

    .simcard-grid .simcard-btn {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        width: 100%;
        height: 100%;
        min-height: 64px;
        margin: 0;
        padding: 6px 8px;
        border: 0;
        border-radius: inherit;
        background: transparent;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
        -webkit-appearance: none;
        appearance: none;
    }
    /* Hover/focus phủ kín thẻ ngoài, không chỉ phần nội dung bên trong. */
    .simcard-grid .sim-item.sim-hot:hover,
    .simcard-grid .sim-item.sim-hot:focus-within {
        background: rgba(225, 64, 33, .07);
        outline: 2px solid #E14021;
        outline-offset: -2px;
    }

    .simcard-grid .simcard-btn:hover,
    .simcard-grid .simcard-btn:focus-visible {
        background: transparent;
        outline: none;
        box-shadow: none;
    }

    .simcard-grid .simcard-btn:disabled {
        opacity: .55;
        cursor: wait;
    }

    .simcard-grid .simcard-row {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        min-width: 0;
    }

    .simcard-grid .simcard-logo {
        display: block;
        width: 50px;
        height: auto;
        max-height: 55px;
        flex: 0 0 50px;
        object-fit: contain;
    }

    .simcard-grid .simcard-meta {
        display: block;
        min-width: 0;
    }

    .simcard-grid .sim-item--number {
        display: block;
        overflow-wrap: anywhere;
    }

    .simcard-grid .sim-item--price {
        display: block;
    }

    .simcard-grid .simcard-hidden {
        display: none !important;
    }

    @@media (max-width: 575.98px) {
        .simcard-grid .simcard-btn {
            min-height: 56px;
            padding: 5px 4px;
        }

        .simcard-grid .simcard-row {
            gap: 5px;
        }

        .simcard-grid .simcard-logo {
            width: 35px;
            flex-basis: 35px;
            max-height: 45px;
        }

        .simcard-grid .sim-item--number {
            font-size: 13px;
        }

        .simcard-grid .sim-item--price {
            font-size: 12px;
        }
    }
</style>
<div class="block mt-15 simcard-section">
    <div class="block-head">SIM SỐ ĐẸP</div>
    <div class="block-body p-3">
        <div class="sim-table--body col-12 px-0">
            <div class="sim-table--wrap">
                @if (ViewBag.SimSoDep != null && ViewBag.SimSoDep.Count > 0)
                {
                    <div class="row simcard-grid">
                        @foreach (var item in ViewBag.SimSoDep)
                        {
                            <div class="col-6 col-xl-4 simcard-col js-sim-card" data-sim-id="@item.Id">
                                <div class="sim-item sim-hot">
                                    <button type="button" class="simcard-btn js-sim-add"
                                            data-sim-id="@item.Id"
                                            data-sim-number="@item.SIMNumber"
                                            data-sim-price="@Convert.ToString(item.SIMPrice, System.Globalization.CultureInfo.InvariantCulture)"
                                            aria-label="Thêm SIM @item.SIMNumber vào giỏ hàng">
                                        <span class="simcard-row">
                                            <img class="simcard-logo" src="@Url.Content(SimNetworkImage(Convert.ToString(item.Network)))"
                                                 alt="Nhà mạng @item.Network" loading="lazy" />
                                            <span class="simcard-meta">
                                                <span class="sim-item--number">@item.SIMNumber</span>
                                                <span class="sim-item--price">@item.SIMPrice.ToString("#,##0") đ</span>
                                            </span>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-12 p-3 text-center">
                        <a class="btn btn-warning" asp-action="Search" asp-controller="Home"
                           asp-route-searchType="@SearchType.sosim" asp-route-slug="0*">Xem thêm ...</a>
                    </div>
                }
                else
                {
                    <h4>Không tìm thấy sản phẩm nào.</h4>
                }
            </div>
        </div>
    </div>
</div>

<div class="block mt-15 simcard-section">
    <div class="block-head">SIM KHUYẾN MÃI</div>
    <div class="block-body p-3">
        <div class="sim-table--body col-12 px-0">
            <div class="sim-table--wrap">
                @if (ViewBag.SimKhuyenMai != null && ViewBag.SimKhuyenMai.Count > 0)
                {
                    <div class="row simcard-grid">
                        @foreach (var item in ViewBag.SimKhuyenMai)
                        {
                            <div class="col-6 col-xl-4 simcard-col js-sim-card" data-sim-id="@item.Id">
                                <div class="sim-item sim-hot">
                                    <button type="button" class="simcard-btn js-sim-add"
                                            data-sim-id="@item.Id"
                                            data-sim-number="@item.SIMNumber"
                                            data-sim-price="@Convert.ToString(item.SIMPrice, System.Globalization.CultureInfo.InvariantCulture)"
                                            aria-label="Thêm SIM @item.SIMNumber vào giỏ hàng">
                                        <span class="simcard-row">
                                            <img class="simcard-logo" src="@Url.Content(SimNetworkImage(Convert.ToString(item.Network)))"
                                                 alt="Nhà mạng @item.Network" loading="lazy" />
                                            <span class="simcard-meta">
                                                <span class="sim-item--number">@item.SIMNumber</span>
                                                <span class="sim-item--price">@item.SIMPrice.ToString("#,##0") đ</span>
                                            </span>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-12 p-3 text-center">
                        <a class="btn btn-warning" asp-action="Search" asp-controller="Home"
                           asp-route-searchType="@SearchType.sosim" asp-route-slug="0*">Xem thêm ...</a>
                    </div>
                }
                else
                {
                    <h4>Không tìm thấy sản phẩm nào.</h4>
                }
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
        "use strict";
        const pending = new Set();
        const simKey = id => String(id);
        const cardSelector = '.simcard-grid .js-sim-card';

        function readCart() {
            if (typeof window.getCart !== 'function') return null;
            try {
                const cart = window.getCart();
                return Array.isArray(cart) ? cart : null;
            } catch (error) {
                console.error('Không đọc được giỏ hàng:', error);
                return null;
            }
        }

        function cartContainsSim(cart, id) {
            if (!Array.isArray(cart)) return false;
            return cart.some(item => item &&
                simKey(item.id ?? item.Id) === simKey(id) &&
                Number(item.type ?? item.Type ?? 0) === 0);
        }

        function hideSimCards(id) {
            document.querySelectorAll(cardSelector).forEach(card => {
                if (simKey(card.dataset.simId) === simKey(id)) {
                    card.classList.add('simcard-hidden');
                }
            });
        }

        function syncVisibleSimCards() {
            const cart = readCart();
            if (!cart) return;
            document.querySelectorAll(cardSelector).forEach(card => {
                if (cartContainsSim(cart, card.dataset.simId)) {
                    hideSimCards(card.dataset.simId);
                }
            });
        }

        // Event delegation: dùng cùng một cơ chế cho PC, mobile, màn hình cảm ứng.
        document.addEventListener('click', function (event) {
            const button = event.target.closest('.simcard-grid .js-sim-add');
            if (!button) return;
            event.preventDefault();

            const id = button.dataset.simId;
            const simNumber = button.dataset.simNumber;
            const price = Number(button.dataset.simPrice);
            const key = simKey(id);

            if (!id || !simNumber || !Number.isFinite(price) || price < 0) {
                console.error('Thông tin SIM không hợp lệ', { id, simNumber, price });
                alert('Thông tin SIM không hợp lệ. Vui lòng tải lại trang.');
                return;
            }
            if (pending.has(key)) return;

            const cartBefore = readCart();
            if (cartContainsSim(cartBefore, id)) {
                hideSimCards(id);
                return;
            }
            if (!cartBefore || typeof window.AddSimToCart !== 'function') {
                alert('Chức năng giỏ hàng chưa sẵn sàng. Vui lòng tải lại trang.');
                return;
            }

            pending.add(key);
            button.disabled = true;
            try {
                // _Layout.cshtml: AddSimToCart(id, simNumber, price)
                // -> addToCart(id, simNumber, 0, price, 1, false).
                // Chỉ xóa khỏi danh sách sau khi giỏ hàng đã lưu thành công.
                const numericId = Number(id);
                window.AddSimToCart(Number.isSafeInteger(numericId) ? numericId : id, simNumber, price);
                const cartAfter = readCart();
                if (cartContainsSim(cartAfter, id)) {
                    hideSimCards(id); // Xóa đồng thời khỏi cả hai khu vực nếu SIM xuất hiện trùng.
                } else {
                    console.error('Không xác nhận được thao tác thêm SIM vào giỏ hàng:', id);
                    alert('Chưa thêm được SIM vào giỏ hàng. Vui lòng thử lại.');
                }
            } catch (error) {
                console.error('Lỗi thêm SIM vào giỏ hàng:', error);
                alert('Có lỗi khi thêm SIM vào giỏ hàng. Vui lòng thử lại.');
            } finally {
                pending.delete(key);
                button.disabled = false;
            }
        });

        function initSimCardPage() {
            document.getElementById('sim-so-dep')?.classList.add('active');
            syncVisibleSimCards();
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSimCardPage);
        } else {
            initSimCardPage();
        }
        window.addEventListener('storage', function (event) {
            // Khi giỏ hàng thay đổi ở tab khác, chỉ ẩn SIM đã nằm trong giỏ.
            if (event.storageArea === localStorage) syncVisibleSimCards();
        });
    })();

    // Giữ lại chức năng xem điểm SIM từ View gốc.
    function SearchSIMOnHome() {
        var simNumber = $("#simNumber").val();
        if (!ValidateUSPhoneNumber(simNumber)) {
            alert('Số bạn nhập chưa đúng');
            return;
        }
        var dateOfBirth = $("#dateOfBirth").val();
        var monthOfBirth = $("#monthOfBirth").val();
        var yearOfBirth = $("#yearOfBirth").val();
        var hourOfBirth = $("#giosinh").val();
        var gioitinh = $("#gioitinh").val();
        var dataReq = {
            "simNumber": String(simNumber || "").replace(/\./g, ""),
            "yearOfBirth": yearOfBirth,
            "monthOfBirth": monthOfBirth,
            "dateOfBirth": dateOfBirth,
            "hourOfBirth": hourOfBirth,
            "minuteOfBirth": 0,
            "isMale": gioitinh,
        }
        $.ajax({
            url: '@Url.Action("XemDiemSim", "Home")',
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(dataReq),
            xhrFields: {
                withCredentials: true // Gửi kèm cookie (nếu bạn đang dùng cookie auth)
            },
            success: function (data) {
                if (data && data.menhchu && data.nguHanhSim && data.amDuongTuongPhoi && data.queBatQuai && data.queBatQuai.queChu && data.quanNiemDanGian) {
                    var fengshuiAbout = document.getElementById("fengshui-about");
                    if (fengshuiAbout) fengshuiAbout.classList.add("hidden");
                    var fengshuiResult = document.getElementById("fengshui-result");
                    if (fengshuiResult) fengshuiResult.classList.remove("hidden");
                    //
                    var congiap = document.getElementById("congiap");
                    if (congiap && data.menhchu.canChi) switch (true) {
                        case data.menhchu.canChi.includes("Tý"):
                            congiap.src = 'congiap/ti.png';
                            break;
                        case data.menhchu.canChi.includes("Sửu"):
                            congiap.src = 'congiap/suu.png';
                            break;
                        case data.menhchu.canChi.includes("Dần"):
                            congiap.src = 'congiap/dan.png';
                            break;
                        case data.menhchu.canChi.includes("Mão"):
                            congiap.src = 'congiap/mao.png';
                            break;
                        case data.menhchu.canChi.includes("Thìn"):
                            congiap.src = 'congiap/thin.png';
                            break;
                        case data.menhchu.canChi.includes("Tỵ"):
                            congiap.src = 'congiap/ty.png';
                            break;
                        case data.menhchu.canChi.includes("Ngọ"):
                            congiap.src = 'congiap/ngo.png';
                            break;
                        case data.menhchu.canChi.includes("Mùi"):
                            congiap.src = 'congiap/mui.png';
                            break;
                        case data.menhchu.canChi.includes("Thân"):
                            congiap.src = 'congiap/than.png';
                            break;
                        case data.menhchu.canChi.includes("Dậu"):
                            congiap.src = 'congiap/dau.png';
                            break;
                        case data.menhchu.canChi.includes("Tuất"):
                            congiap.src = 'congiap/tuat.png';
                            break;
                        default:
                            congiap.src = 'congiap/hoi.png';
                            break;
                    }
                    //
                    $("#sosim").text(simNumber);
                    //Mệnh chủ
                    $("#thanchu").text('Sinh ngày ' + data.birthDay + ' (' + data.lunarBirthDay + ' Âm lịch)');
                    $("#canchi").text(data.menhchu.canChi);
                    $("#menhsinh").text(data.menhchu.cungSinh1 + ' - ' + data.menhchu.cungSinh2);
                    $("#nguhanh").text(data.menhchu.nguHanh);
                    $("#cungphi").text(data.menhchu.cungPhi1 + ' - ' + data.menhchu.cungPhi2);
                    $("#congiap").text(data.menhchu.conGiap);

                    //Âm dương tương phối
                    var tbody = $("#tablept tbody")
                    tbody.children().remove();
                    var simNum = "<tr>";
                    data.nguHanhSim.numberOfSim.forEach((el) => {
                        simNum += '<td class="text-center">' + el + '</td>';
                    });
                    simNum += '</tr>';
                    tbody.append(simNum);

                    var amDuong = "<tr>";
                    data.amDuongTuongPhoi.amDuongTuongPhoi.forEach((el) => {
                        amDuong += '<td class="text-center">' + el + '</td>';
                    });
                    amDuong += '</tr>';
                    tbody.append(amDuong);

                    $("#soam").text(data.amDuongTuongPhoi.soAmAmount);
                    $("#soduong").text(data.amDuongTuongPhoi.soDuongAmount);
                    $("#vanSo").text(data.amDuongTuongPhoi.vanSo);
                    $("#namsinh").text(data.menhchu.namSinh + ' - ' + data.amDuongTuongPhoi.menhAmDuong);

                    //Ngũ hành sim
                    $("#nguhanhmenh").text(data.menhchu.nguHanh);
                    $("#nguhanhsim").text(data.nguHanhSim.nguHanhSim);
                    $("#nguhanhsimtuongsinh").text(data.nguHanhSim.simSinhKhac);

                    var tbody5hanh = $("#nguhanhsimtbl tbody")
                    tbody5hanh.children().remove();
                    var simNum = "<tr>";
                    data.nguHanhSim.numberOfSim.forEach((el) => {
                        simNum += '<td class="text-center">' + el + '</td>';
                    });
                    simNum += '</tr>';
                    tbody5hanh.append(simNum);

                    var nguHanh = "<tr>";
                    data.nguHanhSim.nguHanhOfnumber.forEach((el) => {
                        nguHanh += '<td class="text-center">' + el + '</td>';
                    });
                    nguHanh += '</tr>';
                    tbody5hanh.append(nguHanh);

                    var nguHanhSK = "<tr>";
                    data.nguHanhSim.nguHanhSinhKhac.forEach((el) => {
                        nguHanhSK += '<td class="text-center" colspan="2">' + el + '</td>';
                    });
                    nguHanhSK += '</tr>';
                    tbody5hanh.append(nguHanhSK);
                    //Tong nut
                    $("#queSo").text(data.queBatQuai.queChu.queSo + ' | ' + data.queBatQuai.queChu.queName);
                    // $("#tuongQue").text(data.queBatQuai.queChu.tuongQue);
                    $("#loiKinh").text(data.queBatQuai.queChu.loiKinh);
                    $("#dichAm").text(data.queBatQuai.queChu.dichAm);
                    $("#dichNghia").text(data.queBatQuai.queChu.dichNghia);
                    $("#giaiNghia").text(data.queBatQuai.queChu.giaiNghia);
                    $("#loaiQue").text(data.queBatQuai.queChu.loaiQue);
                    $("#totChoViec").text(data.queBatQuai.queChu.totChoViec);

                    //Tong nut
                    $("#soNut").text(data.quanNiemDanGian.soNut);
                    //Tong diem
                    $("#tongdiem").text(data.quanNiemDanGian.point + data.queBatQuai.point + data.pointCuuTinhDo + data.nguHanhSim.point + data.amDuongTuongPhoi.point);

                }
            },
            error: function (xhr) {
                console.error("Lỗi khi xem điểm SIM:", xhr);
            }
        });
    }
</script>
