<script>
    // Khóa ngay khi bắt đầu gửi để chặn double-click/submit bằng Enter.
    let isOrderSubmitting = false;

    $(function () {
        $('#agreePolicy').on('change', checkAgreePolice);
        checkAgreePolice();
        showCartItems();
    });

    // Ưu tiên renderer gốc của /js/cart.js để giữ đúng giao diện và cấu trúc.
    // Nếu cart.js thiếu/lỗi/không tạo HTML thì dùng giao diện dự phòng an toàn.
    function showCartItems() {
        const $container = $('#cartContainer').empty();
        let cart = [];
        try {
            if (typeof window.getCart !== 'function') {
                $container.text('Chưa tải được dữ liệu giỏ hàng (/js/cart.js). Vui lòng tải lại trang.');
                console.error('getCart() is missing: /js/cart.js');
                return;
            }
            cart = window.getCart();
            if (!Array.isArray(cart)) throw new Error('getCart() phải trả về một mảng');
        } catch (error) {
            console.error('Không đọc được giỏ hàng:', error);
            $container.text('Không đọc được dữ liệu giỏ hàng. Vui lòng tải lại trang.');
            return;
        }

        if (cart.length === 0) {
            $container.append($('<div>', {
                class: 'alert alert-light text-center mb-0',
                text: 'Giỏ hàng đang trống.'
            }));
            return;
        }

        if (typeof window.renderCartList === 'function') {
            try {
                window.renderCartList('cartContainer');
                if ($container.children().length > 0 || $container.text().trim()) return;
                console.warn('renderCartList() không tạo nội dung, chuyển sang giao diện dự phòng.');
            } catch (error) {
                console.error('renderCartList() lỗi; chuyển sang giao diện dự phòng:', error);
            }
        } else {
            console.warn('Thiếu renderCartList() trong /js/cart.js; dùng giao diện dự phòng.');
        }

        // Không sửa cấu trúc giỏ hàng: chỉ đọc các thuộc tính có thể có.
        renderCartFallback($container, cart);
    }

    function renderCartFallback($container, cart) {
        $container.empty();
        const formatter = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 });
        const $list = $('<div>', { class: 'list-group' });
        let total = 0;

        cart.forEach(function (item) {
            if (!item) return;
            const id = item.id ?? item.Id;
            const type = Number(item.type ?? item.Type ?? 0);
            const name = item.name ?? item.Name ?? item.simNumber ?? item.SimNumber ?? item.number ?? item.Number ?? 'SIM ' + String(id ?? '');
            const price = Number(item.price ?? item.Price ?? 0);
            const qty = Number(item.qty ?? item.Qty ?? item.quantity ?? item.Quantity ?? 1);
            const safePrice = Number.isFinite(price) ? price : 0;
            const safeQty = Number.isFinite(qty) && qty > 0 ? qty : 1;
            total += safePrice * safeQty;
            const label = type === 0 ? 'SIM số' : type === 1 ? 'SIM Data' : 'SIM du lịch';
            const $row = $('<div>', { class: 'list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2' });
            const $info = $('<div>', { class: 'flex-grow-1' });
            $info.append($('<div>', { class: 'fw-bold', text: String(name) }));
            $info.append($('<div>', { class: 'small text-muted', text: label + ' · SL: ' + safeQty }));
            $info.append($('<div>', { class: 'fw-semibold', text: formatter.format(safePrice * safeQty) + ' đ' }));
            const $remove = $('<button>', {
                type: 'button', class: 'btn btn-outline-danger btn-sm',
                text: 'Xóa', 'aria-label': 'Xóa ' + name + ' khỏi giỏ hàng'
            }).on('click', function () {
                if (isOrderSubmitting) return;
                if (typeof window.deleteItem !== 'function') {
                    alert('Chức năng xóa giỏ hàng chưa được tải.');
                    return;
                }
                DeleteItem(id, type);
            });
            $row.append($info, $remove);
            $list.append($row);
        });
        $container.append($list);
        $container.append($('<div>', {
            class: 'text-end fw-bold mt-3',
            text: 'Tạm tính: ' + formatter.format(total) + ' đ'
        }));
    }

    function checkAgreePolice() {
        $('#createOrderBtn').prop('disabled', isOrderSubmitting || !$('#agreePolicy').prop('checked'));
    }

    function setOrderSubmitting(submitting) {
        isOrderSubmitting = submitting;
        const $button = $('#createOrderBtn');
        $button.prop('disabled', submitting || !$('#agreePolicy').prop('checked'));
        $button.find('.order-btn-label').toggleClass('d-none', submitting);
        $button.find('.order-btn-loading').toggleClass('d-none', !submitting);
        $button.attr('aria-busy', submitting ? 'true' : 'false');
    }

    function OrderSim(event) {
        if (event) event.preventDefault();
        if (isOrderSubmitting) return false;

        const form = document.getElementById('ordered');
        if (!form.checkValidity()) {
            form.reportValidity();
            return false;
        }
        if (!$('#agreePolicy').prop('checked')) {
            alert('Bạn cần đồng ý với Chính sách bảo mật.');
            return false;
        }

        let itemInCarts;
        try {
            itemInCarts = window.getCart();
        } catch (error) {
            console.error('getCart() lỗi:', error);
            alert('Không đọc được giỏ hàng. Vui lòng tải lại trang.');
            return false;
        }
        const cusName = $('#fullname').val().trim();
        const cusPhone = $('#phone').val().trim();
        const cusAddress = $('#address').val().trim();
        const cusProvince = $('#city').val();
        const cusNote = $('#note').val().trim();
        const paymentMethod = $('#pay_method2').prop('checked') ? 1 : 0;

        if (!Array.isArray(itemInCarts) || itemInCarts.length === 0) {
            alert('Giỏ hàng đang trống. Vui lòng chọn sim trước khi đặt mua.');
            return false;
        }
        if (!cusName || !cusPhone || !cusAddress || !cusProvince || cusProvince === '0') {
            alert('Bạn chưa nhập đủ thông tin đặt sim.');
            return false;
        }

        const dataReq = {
            ItemInCarts: itemInCarts,
            CusName: cusName,
            CusPhone: cusPhone,
            CusAddress: cusAddress,
            CusProvince: cusProvince,
            CusNote: cusNote,
            PaymentMethod: paymentMethod
        };

        // Khóa trước khi gọi AJAX (không chờ đến callback).
        setOrderSubmitting(true);

        $.ajax({
            url: '@Url.Action("CreateOrderInCart", "Home")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dataReq),
            timeout: 30000,
            xhrFields: { withCredentials: true }
        }).done(function (data) {
            if (data && String(data.code) === '1') {
                clearCart();
                window.location.href = '@Url.Action("OrderSuccess", "Home")';
                // Giữ nút bị khóa khi đang chuyển trang.
                return;
            }

            if (data && String(data.code) === '-2') {
                alert(data.message || 'Không thể đặt sim. Vui lòng kiểm tra lại đơn hàng.');
            } else {
                alert('Có lỗi trong quá trình đặt sim. Vui lòng liên hệ số hỗ trợ để được tư vấn.');
            }
            setOrderSubmitting(false);
        }).fail(function (xhr, status) {
            console.error('CreateOrderInCart failed:', status, xhr);
            alert(status === 'timeout'
                ? 'Yêu cầu đã quá thời gian chờ. Vui lòng kiểm tra đơn hàng trước khi thử lại để tránh đặt trùng.'
                : 'Không thể kết nối để đặt sim. Vui lòng kiểm tra đơn hàng trước khi thử lại.');
            setOrderSubmitting(false);
        });

        return false;
    }

    function DeleteItem(id, type) {
        if (isOrderSubmitting) return;
        if (typeof window.deleteItem !== 'function') return;
        window.deleteItem(id, type);
        if (typeof window.UpdateCartIconAmount === 'function') window.UpdateCartIconAmount();
        showCartItems();
    }

    function OnClickESim(id, type) {
        if (isOrderSubmitting) return;
        const checkbox = document.getElementById(String(id) + String(type));
        if (!checkbox) return;

        if (typeof window.getCart !== 'function' || typeof window.saveCart !== 'function') return;
        const cart = window.getCart();
        if (!Array.isArray(cart)) return;
        const item = cart.find(i => String(i.id ?? i.Id) === String(id) && String(i.type ?? i.Type) === String(type));
        if (!item) return;

        item.esim = checkbox.checked;
        saveCart(cart);
        showCartItems();
    }
</script>
